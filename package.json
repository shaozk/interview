{
  "name": "interview",
  "private": true,
  "version": "0.1.0",
  "description": "面面：面试日程集中管理。纯规则解析、零 AI 依赖，部署到你自己的 Cloudflare。",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --config vite.config.pages.ts",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler d1 migrations apply interview-db --remote && wrangler deploy",
    "predeploy": "node scripts/check-config.mjs",
    "postdeploy": "node scripts/smoke.mjs",
    "smoke": "node scripts/smoke.mjs",
    "migrate:local": "wrangler d1 migrations apply interview-db --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "workerd@1.20261006.1": true,
    "esbuild@0.28.2": true
  }
}
